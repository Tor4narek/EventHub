# One configuration file for all services. Copy it to .env in the repository root.
POSTGRES_DB=eventhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

API_PORT=8456
ADMIN_PORT=8457
WEBAPP_PORT=5174
# Required for the production profile and automatic HTTPS certificates.
API_DOMAIN=
ADMIN_DOMAIN=
WEBAPP_DOMAIN=
Swagger__Enabled=false

Jwt__Issuer=EventHubAPI
Jwt__Audience=EventHubClients
Jwt__SigningKey=
Admin__Username=admin
Admin__PasswordHash=

Max__BotToken=
Max__ApiBaseUrl=https://platform-api2.max.ru
Max__WebhookSecret=
Max__WebAppName=

MINIO_ROOT_USER=eventhubminio
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9500
MINIO_CONSOLE_PORT=9501
Minio__Endpoint=localhost:9500
Minio__AccessKey=eventhubminio
Minio__SecretKey=
Minio__BucketName=eventhub-images
Minio__UseSsl=false
# Local: http://localhost:8456; server: https://<API_DOMAIN>
Minio__PublicBaseUrl=http://localhost:8456

# Both frontends use their own /api reverse proxy in Docker, so CORS is optional.
# Cors__Origins__0=https://your-webapp-domain.example
